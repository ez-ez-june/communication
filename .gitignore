# Ignore everything by default
*

# Keep published board HTML only (no templates / legacy boards)
!gov_notice_board.html
!gov_notice_board_mobile.html
!index.html

# Keep Python collector (Lightsail source mirror)
!*.py
!requirements.txt
!parsers/
!parsers/**
!config/
!config/**
!data/
!data/**

# Keep GitHub Actions
!.github/
!.github/**

!.gitignore

# Local / secrets / Excel (not for Pages)
.env
.env.*
__pycache__/
*.pyc
.venv/
venv/
~$*
xlsm_extract/
*.log
업데이트.md
보관-레거시/
data/*_prev.json
*.xlsm
*.xlsx
*.xls
*.bas
*.md
